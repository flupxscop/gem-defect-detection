# Roboflow settings for src/download.py. Copy to .env and fill in.
# API key: Roboflow -> Settings -> API Keys (keep it private; .env is gitignored)
ROBOFLOW_API_KEY=
# From your project URL: https://app.roboflow.com/<workspace>/<project>/<version>
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=1
